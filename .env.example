OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

HF_TOKEN=your_huggingface_token
SECRET_KEY=replace_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@hopemo.7136dc8.mongodb.net/?appName=hopemo
MONGODB_DB=hopemo

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Email OTP verification (for Gmail use smtp.gmail.com and an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# Google Sign-In (use the Web application client ID; this value is safe for Vercel too)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
